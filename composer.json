{
    "name": "islamrumon/laravel-acl",
    "description": "This package provides a complete Access Control List management",
    "type": "laravel-package",
    "version": "2.2.0",
    "keywords": [
        "laravel",
        "junges",
        "acl",
        "security",
        "permissions",
        "access-control-list"
    ],
    "support": {
        "issues": "https://github.com/islamrumon/laravel-acl/issues",
        "source": "https://github.com/islamrumon/laravel-acl"
    },
    "homepage": "https://github.com/islamrumon/laravel-acl",
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
        "illuminate/auth": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/container": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0",
        "predis/predis": "^1.1|^2.0|^3.0",
        "friendsofphp/php-cs-fixer": "^3.4|^3.64"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Islam Rumon",
            "email": "islamrumon707@gmail.com",
            "role": "FullStack Software Engineer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Junges\\ACL\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Junges\\ACL\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Junges\\ACL\\Providers\\ACLServiceProvider",
                "Junges\\ACL\\Providers\\ACLAuthServiceProvider",
                "Junges\\ACL\\Providers\\ACLEventsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes --config=.php_cs.dist.php"
    }
}